# Leave VITE_USE_MOCK_DATA=true while the backend is not running.
VITE_USE_MOCK_DATA=true

# Supabase Project Settings > API. These values are safe for browser use only
# when Row Level Security remains enabled. Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_EVENT_DATABASE_ID=1

# REST API origin, without a trailing slash. Leave blank for the same origin.
# Example for a separate backend: http://localhost:8080
VITE_API_BASE_URL=

# WebSocket origin, without a trailing slash. Leave blank for the same origin.
# Example for a separate backend: ws://localhost:8080
VITE_WS_URL=

# Public event identifier used by REST and WebSocket routes.
VITE_EVENT_ID=SUPER_CONCERT_2026
